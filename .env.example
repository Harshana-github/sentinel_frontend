# Every VITE_ variable is bundled into the browser build. Never put secrets here.

# Base URL of the Sentinel FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# true  = use the built-in demonstration data (no backend needed)
# false = send requests to VITE_API_BASE_URL
VITE_USE_MOCK_DATA=true
